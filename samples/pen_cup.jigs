# Pen cup: the PDF's starter project 4 (acceptance scenario A3), driven by parameters.
# Change height, dia or wall and the whole cup follows.
param height = 95 mm
param dia = 80 mm
param wall = 2.4 mm

sketch id=s1 plane=XY name="Cup outline"
circle sketch=s1 center=0,0 d=dia
extrude id=e1 sketch=s1 distance=height op=new name="Cup"

# Hollow it, leaving the top open.
shell id=sh1 faces="face:e1/end" thickness=wall name="Hollow"

# Soften the outside bottom edge and the rim. (The guide suggests 1.5 mm on the rim,
# but two 1.5 mm rounds need a 3 mm wall; with a 2.4 mm wall, 1 mm fits.)
fillet id=f1 edges="name:E[e1/side:2|e1/start]" radius=2mm name="Base round"
fillet id=f2 edges="face:e1/end" radius=1mm name="Rim round"

# Engraved name: Text arrives in milestone M5.
